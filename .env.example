# =============================================================================
# Shared Environment Variables
# =============================================================================
# Copy this file to .env and customize for your local environment.
# These values override the defaults embedded in the code.

# Node environment
NODE_ENV=development

# Service ports (only needed when running outside Docker)
INVENTORY_PORT=8003
ORDERS_PORT=8002
GATEWAY_PORT=8000

# Database connections (for running services outside Docker)
MONGO_URI=mongodb://localhost:27018/inventory_db
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orders_db

# Kafka
KAFKA_BROKERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API Gateway
INVENTORY_URL=http://localhost:8004
ORDERS_URL=http://localhost:8005
