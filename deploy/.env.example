# =============================================================================
# EC2 Deployment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running deploy scripts.

# Docker Hub username (or ECR registry URL)
REGISTRY_USER=dockerhub-user
IMAGE_TAG=latest

# EC2 instance IPs — one per service
INVENTORY_EC2_IP=54.123.45.1
ORDERS_EC2_IP=54.123.45.2
GATEWAY_EC2_IP=54.123.45.3

# SSH key for connecting to EC2 instances
SSH_KEY_PATH=~/.ssh/microservices-key.pem
SSH_USER=ec2-user

# API Gateway config
GATEWAY_PORT=80   # 80 if using nginx, 8000 for direct
INVENTORY_URL=http://<inventory-ec2-ip>:8003
ORDERS_URL=http://<orders-ec2-ip>:8002

# External infra endpoints (use the actual EC2 IP of the infra instance)
KAFKA_BROKERS=kafka-ec2-ip:9092
REDIS_HOST=redis-ec2-ip
MONGO_URI=mongodb://mongo-ec2-ip:27017/inventory_db
POSTGRES_HOST=postgres-ec2-ip
